heme Builder, layout 41). Solo tokens del sistema: --gcid-* colores, --gvid-* variables. *\/\n.ssm-toggle{display:flex;align-items:center;justify-content:center;width:44px;height:44px;margin:0 -8px 0 0;padding:0;border:0;background:none;color:var(--gcid-heading-color);cursor:pointer}\n.ssm-toggle svg{width:var(--gvid-gupqrxqjha);height:var(--gvid-gupqrxqjha)}\n.ssm-toggle .ssm-icon-close,.ssm-toggle[aria-expanded=\"true\"] .ssm-icon-open{display:none}\n.ssm-toggle[aria-expanded=\"true\"] .ssm-icon-close{display:block}\n.ssm-toggle:focus-visible{outline:2px solid var(--gcid-primary-color);outline-offset:2px;border-radius:var(--gvid-4sil5vvzez)}\n.ssm-panel{position:fixed;left:0;right:0;top:0;z-index:98;display:grid;grid-template-rows:0fr;visibility:hidden;background:var(--gcid-z44qg3qevy);transition:grid-template-rows .3s ease,visibility 0s linear .3s}\n.ssm-panel.is-open{grid-template-rows:1fr;visibility:visible;transition:grid-template-rows .3s ease,visibility 0s;box-shadow:0 24px 32px -24px color-mix(in srgb,var(--gcid-vdcqqbuvlk) 25%,transparent)}\n.ssm-inner{overflow:hidden;min-height:0}\n.ssm-panel ul{list-style:none;margin:0;padding:0;border-top:1px solid color-mix(in srgb,var(--gcid-primary-color) 10%,transparent)}\n.ssm-panel li{margin:0;padding:0;border-bottom:1px solid color-mix(in srgb,var(--gcid-primary-color) 10%,transparent)}\n.ssm-panel a{display:block;padding:var(--gvid-sjlrypwvt0) var(--ssm-inset,5vw);font-family:var(--et_global_heading_font);font-size:var(--gvid-vfe3ztufny);line-height:1.2;letter-spacing:.02em;text-transform:uppercase;color:var(--gcid-heading-color);text-decoration:none;transition:color .2s ease}\n.ssm-panel a:hover,.ssm-panel a:focus-visible,.ssm-panel a[aria-current=\"page\"]{color:var(--gcid-primary-color)}\n@media (prefers-reduced-motion:reduce){.ssm-panel,.ssm-panel.is-open{transition:none}}\n<\/style>\n<script>\n(function () {\n\tif (window.ssmReady) return;\n\twindow.ssmReady = true;\n\tvar open = null; \/\/ the .ssm currently open\n\n\tfunction place(menu) {\n\t\tvar panel = menu.querySelector('.ssm-panel');\n\t\tvar bar = menu.closest('.et_pb_section') || menu;\n\t\tvar row = menu.closest('.et_pb_row') || bar;\n\t\tvar top = Math.max(0, bar.getBoundingClientRect().bottom);\n\t\tpanel.style.top = top + 'px';\n\t\t\/\/ If an ancestor turns \"fixed\" into \"relative to it\" (transforms), correct the offset.\n\t\tvar drift = panel.getBoundingClientRect().top - top;\n\t\tif (Math.abs(drift) > 1) panel.style.top = (top - drift) + 'px';\n\t\tpanel.style.setProperty('--ssm-inset', Math.max(0, row.getBoundingClientRect().left) + 'px');\n\t}\n\n\tfunction set(menu, state) {\n\t\tvar toggle = menu.querySelector('.ssm-toggle');\n\t\tif (state) place(menu);\n\t\tmenu.querySelector('.ssm-panel').classList.toggle('is-open', state);\n\t\ttoggle.setAttribute('aria-expanded', state ? 'true' : 'false');\n\t\ttoggle.setAttribute('aria-label', state ? 'Cerrar men\u00fa' : 'Abrir men\u00fa');\n\t\topen = state ? menu : null;\n\t}\n\n\tdocument.addEventListener('click', function (e) {\n\t\tvar toggle = e.target.closest('.ssm-toggle');\n\t\tif (toggle) {\n\t\t\tvar menu = toggle.closest('.ssm');\n\t\t\tif (open && open !== menu) set(open, false);\n\t\t\tset(menu, open !== menu);\n\t\t\treturn;\n\t\t}\n\t\tif (open && (e.target.closest('.ssm-panel a') || !e.target.closest('.ssm-panel'))) set(open, false);\n\t});\n\tdocument.addEventListener('keydown', function (e) {\n\t\tif (e.key === 'Escape' && open) {\n\t\t\tvar toggle = open.querySelector('.ssm-toggle');\n\t\t\tset(open, false);\n\t\t\ttoggle.focus();\n\t\t}\n\t});\n\twindow.addEventListener('scroll', function () { if (open) place(open); }, { passive: true });\n\twindow.addEventListener('resize', function () { if (open) { if (window.innerWidth > 980) set(open, false); else place(open); } });\n\n\tfunction markCurrent() {\n\t\tvar here = location.pathname.replace(\/\\\/+$\/, '') + '\/';\n\t\tdocument.querySelectorAll('.ssm-panel a').forEach(function (a) {\n\t\t\tif (new URL(a.href, location.href).pathname.replace(\/\\\/+$\/, '') + '\/' === here) a.setAttribute('aria-current', 'page');\n\t\t});\n\t}\n\tif (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', markCurrent); else markCurrent();\n})();\n<\/script>\n"}}},"module":{"meta":{"adminLabel":{"desktop":{"value":"Men\u00fa m\u00f3vil"}}}},"builderVersion":"5.14.0"},"children":[]}]}]}]}]}]}],"canvases":[],"theme_builder":{"area":"header","live_templates_using":[42]}}}
